{
	"name": "www.toolv.cn",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "微工具（Micro Tools）：小而美的在线开发者工具集合，覆盖网络调试、编解码、转换、计算查询等，数据全部在浏览器本地处理",
	"keywords": [
		"svelte",
		"sveltekit",
		"svelte-5",
		"runes",
		"tailwindcss",
		"cloudflare-pages",
		"websocket",
		"developer-tools",
		"在线工具",
		"微工具"
	],
	"homepage": "https://www.toolv.cn",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/toolvcn/www.toolv.cn.git"
	},
	"bugs": {
		"url": "https://github.com/toolvcn/www.toolv.cn/issues"
	},
	"author": "无情",
	"license": "MIT",
	"packageManager": "pnpm@12.4.2",
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types --check && vite build && cd .svelte-kit/cloudflare && prettier --write '*.html' --print-width 999 --html-whitespace-sensitivity ignore",
		"preview": "wrangler pages dev .svelte-kit/cloudflare --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"gen": "wrangler types",
		"check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . --cache --cache-location node_modules/.cache/prettier.json && eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint",
		"format": "prettier --write . --cache --cache-location node_modules/.cache/prettier.json",
		"test": "pnpm run test:unit -- --run",
		"test:unit": "vitest",
		"test:e2e": "playwright test",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"deploy": "wrangler pages deploy .svelte-kit/cloudflare --commit-dirty=true",
		"deploy:preview": "wrangler pages deploy .svelte-kit/cloudflare --branch=preview --commit-dirty=true"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "latest",
		"@eslint/js": "^10.0.1",
		"@lucide/svelte": "^1.46.0",
		"@playwright/test": "1.62.1",
		"@storybook/addon-a11y": "10.5.9",
		"@storybook/addon-docs": "10.5.9",
		"@storybook/addon-svelte-csf": "latest",
		"@storybook/addon-vitest": "10.5.9",
		"@storybook/sveltekit": "10.5.9",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.13.5",
		"@vitest/browser-playwright": "^4.1.11",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "10.5.9",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"playwright": "^1.63.0",
		"prettier": "^3.9.7",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"storybook": "10.5.9",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^2.2.1",
		"wrangler": "^4.132.0"
	}
}
